[global]
monitor = 0
follow = mouse
origin = top-right
offset = (10, 10)

width = 300
height = (0, 300)

transparency = 10
frame_width = 1
separator_height = 2
padding = 8
horizontal_padding = 8
font = Monospace 10
markup = yes
word_wrap = yes
corner_radius = 6

[urgency_low]
background = "#222222"
foreground = "#bbbbbb"
timeout = 5

[urgency_normal]
background = "#285577"
foreground = "#ffffff"
timeout = 6

[urgency_critical]
background = "#900000"
foreground = "#ffffff"
timeout = 0
