;; BEGIN rafex EWW dashboard
;; Columna derecha, tipo desktop, sin reserve y detrás de ventanas normales.
(defpoll rafex-time :interval "1s" :initial "00:00" "$HOME/.local/bin/eww-actions.sh --value time")
(defpoll rafex-date :interval "60s" :initial "N/D" "$HOME/.local/bin/eww-actions.sh --value date")
(defpoll rafex-calendar :interval "60s" :initial "N/D" "$HOME/.local/bin/eww-actions.sh --value calendar")
(defpoll rafex-media :interval "5s" :initial "N/D" "$HOME/.local/bin/eww-actions.sh --value media")
(defpoll rafex-notifications :interval "10s" :initial "Pendientes: N/D" "$HOME/.local/bin/eww-actions.sh --value notifications")
(defpoll rafex-devices :interval "30s" :initial "USB montados: N/D\nBluetooth conectados: N/D" "$HOME/.local/bin/eww-actions.sh --value devices")
(defpoll rafex-battery :interval "30s" :initial "Batería: N/D" "$HOME/.local/bin/eww-actions.sh --value battery")
(defpoll rafex-printers :interval "30s" :initial "Epson XP-241: N/D\nXerox Phaser 3020: N/D" "$HOME/.local/bin/eww-actions.sh --value printers")
(defpoll rafex-scanner :interval "30s" :initial "Escáner Epson: N/D" "$HOME/.local/bin/eww-actions.sh --value scanner")
(defpoll rafex-theme :interval "30s" :initial "nord" "$HOME/.local/bin/eww-actions.sh --value theme")

(defwidget card [title]
  (box :class "card" :orientation "v" :space-evenly false
    (label :class "card-title" :text title :xalign 0)
    (children)))

(defwidget quick-button [label action]
  (button :class "quick-button" :onclick action label))

(defwindow rafex-widgets
  :monitor "<primary>"
  :geometry (geometry :x "0px" :y "0px" :width "340px" :height "100%" :anchor "top right")
  :stacking "bg"
  :wm-ignore false
  :windowtype "desktop"
  (box :class "dashboard" :orientation "v" :space-evenly false
    (box :class "card clock-card" :orientation "v" :space-evenly false
      (label :class "brand" :text "RAFEX · THINKPAD" :xalign 0)
      (label :class "clock" :text rafex-time :xalign 0)
      (label :class "date" :text rafex-date :xalign 0)
      (label :class "calendar" :text rafex-calendar :xalign 0 :wrap true))

    (card :title "MULTIMEDIA"
      (box :orientation "v" :space-evenly false
        (label :class "media" :text rafex-media :xalign 0 :wrap true)
        (box :class "button-row" :orientation "h" :space-evenly true
          (button :class "media-button" :onclick "$HOME/.local/bin/eww-actions.sh --action media-prev" "⏮")
          (button :class "media-button" :onclick "$HOME/.local/bin/eww-actions.sh --action media-play" "▶/Ⅱ")
          (button :class "media-button" :onclick "$HOME/.local/bin/eww-actions.sh --action media-next" "⏭"))))

    (card :title "NOTIFICACIONES"
      (box :orientation "h" :space-evenly false
        (label :class "value" :text rafex-notifications :xalign 0)
        (button :class "small-button" :onclick "$HOME/.local/bin/eww-actions.sh --action notifications-history" "historial")))

    (card :title "DISPOSITIVOS"
      (box :orientation "v" :space-evenly false
        (label :class "value" :text rafex-devices :xalign 0)
        (label :class "value compact" :text rafex-printers :xalign 0)
        (label :class "value compact" :text rafex-scanner :xalign 0)))

    (card :title "SALUD DE BATERÍA"
      (label :class "value compact" :text rafex-battery :xalign 0))

    (card :title "CONTROLES RÁPIDOS"
      (box :orientation "v" :space-evenly false
        (box :class "button-row" :orientation "h" :space-evenly true
          (quick-button :label "Pantalla −" :action "$HOME/.local/bin/eww-actions.sh --action screen-down")
          (quick-button :label "Pantalla +" :action "$HOME/.local/bin/eww-actions.sh --action screen-up"))
        (box :class "button-row" :orientation "h" :space-evenly true
          (quick-button :label "Teclado −" :action "$HOME/.local/bin/eww-actions.sh --action kbd-down")
          (quick-button :label "Teclado +" :action "$HOME/.local/bin/eww-actions.sh --action kbd-up"))
        (box :class "button-row" :orientation "h" :space-evenly true
          (quick-button :label "Volumen −" :action "$HOME/.local/bin/eww-actions.sh --action volume-down")
          (quick-button :label "Volumen +" :action "$HOME/.local/bin/eww-actions.sh --action volume-up")
          (quick-button :label "Mute" :action "$HOME/.local/bin/eww-actions.sh --action volume-mute"))
        (box :class "button-row" :orientation "h" :space-evenly true
          (quick-button :label "Wi‑Fi" :action "$HOME/.local/bin/eww-actions.sh --action wifi-toggle")
          (quick-button :label "WWAN" :action "$HOME/.local/bin/eww-actions.sh --action wwan-toggle")
          (quick-button :label "Bluetooth" :action "$HOME/.local/bin/eww-actions.sh --action bluetooth-toggle"))
        (box :class "button-row" :orientation "h" :space-evenly true
          (quick-button :label "Micrófono" :action "$HOME/.local/bin/eww-actions.sh --action microphone-toggle")
          (quick-button :label "Panel Rafex" :action "$HOME/.local/bin/eww-actions.sh --action control-panel"))
        (box :class "button-row" :orientation "h" :space-evenly true
          (quick-button :label "Captura" :action "$HOME/.local/bin/eww-actions.sh --action screenshot")
          (quick-button :label "Bloquear" :action "$HOME/.local/bin/eww-actions.sh --action lock"))
        (box :class "button-row" :orientation "h" :space-evenly true
          (quick-button :label "Suspender" :action "$HOME/.local/bin/eww-actions.sh --action suspend")
          (quick-button :label "Hibernar" :action "$HOME/.local/bin/eww-actions.sh --action hibernate"))
        (box :class "button-row" :orientation "h" :space-evenly true
          (quick-button :label "Reiniciar" :action "$HOME/.local/bin/eww-actions.sh --action reboot")
          (quick-button :label "Apagar" :action "$HOME/.local/bin/eww-actions.sh --action poweroff")
          (quick-button :label "Cerrar sesión" :action "$HOME/.local/bin/eww-actions.sh --action logout"))))))
;; END rafex EWW dashboard
