general {
    colors = true
    interval = 5

    # BEGIN rafex theme
    color_good = "#2e3440"
    color_degraded = "#8f6b26"
    color_bad = "#bf616a"
    # END rafex theme
}

order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "volume master"
order += "load"
order += "memory"
order += "tztime local"

wireless _first_ {
    format_up = " %quality %essid"
    format_down = " down"
}

ethernet _first_ {
    format_up = " up"
    format_down = ""
}

battery all {
    format = " %status %percentage (%remaining)"
    format_down = ""
    status_chr = ""
    status_bat = ""
    status_full = ""
    low_threshold = 15
    threshold_type = percentage
}

volume master {
    format = " %volume"
    format_muted = " muted"
    device = "pulse"
    mixer = "Master"
}

load {
    format = "CPU %1min"
}

memory {
    format = "RAM %used"
}

tztime local {
    format = "%Y-%m-%d %H:%M"
}
