* {
    bg: #f3f1dc;
    fg: #3c4841;
    accent: #8da101;
    selected: #e7e4c9;
}

window { background-color: @bg; border: 2px; border-color: @accent; border-radius: 8px; padding: 12px; }
mainbox, inputbar, message, listview, element { background-color: transparent; }
inputbar { text-color: @fg; padding: 4px; }
prompt, entry { text-color: @fg; }
element { padding: 8px; text-color: @fg; }
element selected { background-color: @selected; text-color: @fg; }
element-text { text-color: inherit; }
