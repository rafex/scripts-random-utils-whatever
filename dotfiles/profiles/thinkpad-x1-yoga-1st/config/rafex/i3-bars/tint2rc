# Tint2 completo para i3; el perfil Openbox conserva su tint2rc separado.
panel_items = TSEC
panel_size = 100% 28
panel_margin = 0 0
panel_padding = 4 2 4
panel_position = top center horizontal
panel_layer = top
panel_monitor = all
wm_menu = 1
font_shadow = 0

# BEGIN rafex theme
panel_background_id = 1
taskbar_background_id = 1
taskbar_active_background_id = 2
taskbar_urgent_background_id = 3
taskbar_name_font_color = #2e3440 100
taskbar_name_active_font_color = #eceff4 100
taskbar_name_urgent_font_color = #eceff4 100
systray_background_id = 1
clock_font_color = #2e3440 100
execp_font_color = #2e3440 100
background_color1 = #e5e9f0 100
background_color2 = #5e81ac 100
background_color3 = #bf616a 100
# END rafex theme

taskbar_mode = multi_desktop
taskbar_padding = 2 2 2
taskbar_name = 1
taskbar_name_padding = 6 3
taskbar_name_font = DejaVu Sans 9
taskbar_name_active_background_id = 2
taskbar_name_urgent_background_id = 3
taskbar_name_icon = 1
task_icon = 1
task_icon_size = 18
task_maximum_size = 0 0
systray_padding = 4 0
systray_icon_size = 16
systray_sort = ascending
clock_format = %a %d %b  %H:%M
clock_font = DejaVu Sans Mono 9
clock_padding = 6 2
execp_command = ~/.local/bin/tint2-status.sh
execp_interval = 5
execp_has_icon = 0
execp_tooltip = 0
execp_font = DejaVu Sans Mono 9
execp_padding = 6 2
