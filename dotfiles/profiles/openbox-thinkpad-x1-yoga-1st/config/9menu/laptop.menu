Terminal y tmux:exec alacritty
Terminal RXVT y tmux:exec urxvt -e ~/.local/bin/start-thinkpad-tmux
Aplicaciones:exec rofi -show drun -show-icons
Navegador:exec firefox
Archivos:exec thunar
Audio:exec pavucontrol
Red:exec nm-connection-editor
Wi-Fi:exec ~/.local/bin/wifi-toggle.sh toggle
Modo avion:exec ~/.local/bin/flight-mode-toggle.sh toggle
Bluetooth:exec blueman-manager
Microfono:exec ~/.local/bin/microphone-notify.sh toggle
Pantallas:exec arandr
Proyector:exec ~/.local/bin/screen-projector.sh --apply --mode next
Camara:exec guvcview
Pluma Wacom:exec ~/.local/bin/test-wacom-pen.sh --check
Centro de control:exec ~/.local/bin/desktop-settings-menu.sh
Tema claro/oscuro:exec ~/.local/bin/theme-toggle.sh --toggle
Estado del sistema:exec alacritty -e btop
Captura completa:exec ~/.local/bin/screenshot.sh --full
Captura de area:exec ~/.local/bin/screenshot.sh --select
Captura de ventana:exec ~/.local/bin/screenshot.sh --window
Portapapeles CopyQ:exec ~/.local/bin/clipboard-menu.sh --show
Bloquear sesión:exec loginctl lock-session
Cerrar menú:exit
Cerrar sesión:exec ~/.local/bin/desktop-settings-menu.sh logout
Suspender:exec ~/.local/bin/desktop-settings-menu.sh suspend
Hibernar:exec ~/.local/bin/desktop-settings-menu.sh hibernate
Reiniciar:exec ~/.local/bin/desktop-settings-menu.sh reboot
Apagar:exec ~/.local/bin/desktop-settings-menu.sh poweroff
