<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Rafex</vendor>
  <vendor_url>https://rafex.dev</vendor_url>
  <action id="org.rafex.kbd-backlight">
    <description>Modificar la retroiluminación del teclado ThinkPad</description>
    <message>Se requiere autorización para modificar la retroiluminación del teclado</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/rafex-kbd-backlight</annotate>
  </action>
</policyconfig>
