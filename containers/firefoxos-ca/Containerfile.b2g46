FROM debian:bookworm-slim AS build

ARG NSS_VERSION=3.21
ARG NSPR_VERSION=4.11

ENV DEBIAN_FRONTEND=noninteractive

COPY b2g46-source/ /opt/b2g46-source/

RUN apt-get update \
    && apt-get install --no-install-recommends --yes \
       ca-certificates \
       gcc \
       g++ \
       make \
       perl \
       python3 \
       zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# NSS and NSPR are built from the exact Gecko/B2G tree observed in the
# Flame. The source bundle is verified by the host before it reaches here;
# no out-of-tree patch is applied because the historical changes are already
# part of the pinned Gecko commit.
COPY b2g46-source/b2g/ /opt/b2g/

# El build NSS histórico busca NSPR como hermano de security/nss. En el
# árbol Gecko/B2G de origen el directorio se llama nsprpub; este enlace solo
# adapta la topología del contexto de compilación y no modifica las fuentes.
RUN ln -s ../nsprpub /opt/b2g/security/nspr

RUN test -f /opt/b2g/security/nss/TAG-INFO \
    && test -f /opt/b2g/nsprpub/TAG-INFO \
    && grep -Fqx "NSS_3_21_RTM" /opt/b2g/security/nss/TAG-INFO \
    && grep -Fqx "NSPR_4_11_RTM" /opt/b2g/nsprpub/TAG-INFO \
    && grep -Fq '#define NSS_VERSION  "3.21"' /opt/b2g/security/nss/lib/nss/nss.h \
    && grep -Fq '#define PR_VERSION  "4.11"' /opt/b2g/nsprpub/pr/include/prinit.h

WORKDIR /opt/b2g/security/nss

RUN make nss_build_all BUILD_OPT=1 USE_64=1 NSS_DISABLE_GTESTS=1 NSS_ENABLE_WERROR=0 \
    && install --directory /opt/legacy-nss/bin /opt/legacy-nss/lib \
    && legacy_certutil="$(find /opt/b2g/security/nss -type f -name certutil -print -quit)" \
    && test -n "${legacy_certutil}" \
    && install --strip "${legacy_certutil}" /opt/legacy-nss/bin/certutil \
    && find /opt/b2g/security/nss/dist \( -type f -o -type l \) \
       \( -name '*.so' -o -name '*.so.*' -o -name '*.chk' \) \
       -exec cp --dereference --preserve=mode,timestamps {} /opt/legacy-nss/lib/ \;

FROM debian:bookworm-slim

ARG NSS_VERSION=3.21
ARG NSPR_VERSION=4.11
ARG B2G_VERSION=46.0a1
ARG B2G_BUILD_ID=20151221215202
ARG B2G_SOURCE_REPOSITORY=4a4a0bcf45995fdc29caefba2766932dfc25be7d
ARG B2G_LIBNSS3_SHA256=unresolved
ARG B2G_PATCHES_SHA256=embedded-in-source
ARG B2G_SOURCE_TREE_SHA256=unresolved
ARG RUNTIME_STATUS=unresolved

LABEL org.opencontainers.image.title="Rafex B2G Flame NSS certutil" \
      org.opencontainers.image.description="NSS certutil built from the verified Gecko/B2G 46 Flame source commit" \
      org.opencontainers.image.version="${NSS_VERSION}" \
      org.rafex.firefoxos.runtime="b2g46-flame" \
      org.rafex.firefoxos.runtime-status="${RUNTIME_STATUS}" \
      org.rafex.firefoxos.target="flame" \
      org.rafex.firefoxos.b2g-version="${B2G_VERSION}" \
      org.rafex.firefoxos.build-id="${B2G_BUILD_ID}" \
      org.rafex.firefoxos.source-repository="${B2G_SOURCE_REPOSITORY}" \
      org.rafex.firefoxos.libnss3-sha256="${B2G_LIBNSS3_SHA256}" \
      org.rafex.firefoxos.nss-patches-sha256="${B2G_PATCHES_SHA256}" \
      org.rafex.firefoxos.b2g-source-tree-sha256="${B2G_SOURCE_TREE_SHA256}" \
      org.rafex.firefoxos.nss="${NSS_VERSION}" \
      org.rafex.firefoxos.nspr="${NSPR_VERSION}"

COPY --from=build /opt/legacy-nss /opt/legacy-nss

ENV LD_LIBRARY_PATH=/opt/legacy-nss/lib

ENTRYPOINT ["/opt/legacy-nss/bin/certutil"]
